#!/bin/bash
# Ersatz für systemctl im Test-Container (dort läuft kein systemd).
# Startet die Odin-API so, wie es die Unit-Datei vorgibt: als mira-agent.
set -u
cmd="${1:-}"; shift || true
start_api() {
  pkill -f odin-api.mjs 2>/dev/null; sleep 0.5
  exec_line=$(sed -n 's/^ExecStart=//p' /etc/systemd/system/mira-odin-api.service)
  setsid nohup runuser -u mira-agent -- $exec_line >>/var/log/mira-odin-api.log 2>&1 < /dev/null &
}
for unit in "$@"; do
  case "$cmd:$unit" in
    restart:mira-odin-api|start:mira-odin-api) start_api ;;
    stop:mira-odin-api) pkill -f odin-api.mjs || true ;;
    restart:mira-odin-api-firewall|start:mira-odin-api-firewall) nft -f /etc/mira-odin-api/firewall.nft ;;
    stop:mira-odin-api-firewall) nft delete table inet mira_odin_api 2>/dev/null || true ;;
  esac
done
case "$cmd" in
  is-active) pgrep -f odin-api.mjs >/dev/null ;;
  *) exit 0 ;;
esac
