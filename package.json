{
  "name": "mira",
  "private": true,
  "version": "0.3.0",
  "description": "MIRA – Management, Infrastructure, Resources & Automation",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "odin-api"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w @mira/backend",
    "dev:frontend": "npm run dev -w @mira/frontend",
    "build": "npm run build -w @mira/shared && npm run build -w @mira/backend && npm run build -w @mira/frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w @mira/backend -w @mira/odin-api",
    "start": "node backend/dist/server.js",
    "build:odin-api": "npm run build -w @mira/odin-api",
    "package:odin-api": "npm run package -w @mira/odin-api"
  }
}
