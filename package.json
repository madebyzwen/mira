{
  "name": "mira",
  "private": true,
  "version": "0.7.1",
  "description": "MIRA – Management, Infrastructure, Resources & Automation",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "agent"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w @mira/backend",
    "dev:frontend": "npm run dev -w @mira/frontend",
    "build": "npm run build -w @mira/shared && npm run build -w @mira/backend && npm run build -w @mira/frontend",
    "typecheck": "npm run typecheck --workspaces",
    "check:naming": "sh scripts/check-naming.sh",
    "test": "npm test -w @mira/backend -w @mira/agent",
    "start": "node backend/dist/server.js",
    "build:agent": "npm run build -w @mira/agent",
    "package:agent": "npm run package -w @mira/agent"
  }
}
