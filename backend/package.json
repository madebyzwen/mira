{
  "name": "@mira/backend",
  "private": true,
  "version": "0.9.0",
  "description": "MIRA – Backend (Core und Fachmodule)",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "node --conditions=source --env-file-if-exists=.env --watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@mira/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mira/agent": "*",
    "@mira/shelly-logger": "*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
