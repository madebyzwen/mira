# Lokale Entwicklung: als .env kopieren (wird nicht versioniert)
MIRA_DATA_DIR=../data
MIRA_LOG_LEVEL=info
MIRA_ADMIN_USER=admin
MIRA_ADMIN_DISPLAY_NAME=Admin
# Datei mit dem Startpasswort (mind. 12 Zeichen), wird nur beim allerersten Start gelesen
MIRA_ADMIN_PASSWORD_FILE=../data/admin_password.txt
