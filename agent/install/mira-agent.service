[Unit]
Description=MIRA-Agent (liefert Systemdaten des KI-Servers an MIRA, nur lesend)
Documentation=https://github.com/madebyzwen/mira/blob/main/docs/architektur/agent.md
After=network-online.target mira-agent-firewall.service
Wants=network-online.target

[Service]
Type=simple
User=mira-agent
Group=mira-agent
ExecStart=__NODE_BIN__ /opt/mira-agent/mira-agent.mjs --config /etc/mira-agent/config.json
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5

# Härtung: kein Rechtegewinn, nur lesender Zugriff auf das System
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
